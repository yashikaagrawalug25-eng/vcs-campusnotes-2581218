#!/bin/sh

message=$(head -n 1 "$1")

if [ ${#message} -lt 10 ]; then
    echo "Commit blocked: message must be at least 10 characters."
    exit 1
fi

case "$message" in
    feat:*|fix:*|docs:*|refactor:*|chore:*)
        exit 0
        ;;
    *)
        echo "Commit blocked: message must start with feat:, fix:, docs:, refactor:, or chore:."
        exit 1
        ;;
esac
